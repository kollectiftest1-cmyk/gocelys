# Variables d'environnement Gocelsys (production). En développement, rien n'est nécessaire.
# Sur le VPS, le script deploy/deploy.sh génère ce fichier dans /etc/gocelsys/gocelsys.env.
GOCELSYS_DEBUG=false
GOCELSYS_SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
GOCELSYS_ALLOWED_HOSTS=gocelsys.com,www.gocelsys.com
GOCELSYS_CSRF_TRUSTED_ORIGINS=https://gocelsys.com,https://www.gocelsys.com
GOCELSYS_CORS_ORIGINS=https://gocelsys.com
GOCELSYS_HTTPS=true
# PostgreSQL (si GOCELSYS_DB_NAME est défini, SQLite n'est plus utilisé)
GOCELSYS_DB_NAME=gocelsys
GOCELSYS_DB_USER=gocelsys
GOCELSYS_DB_PASSWORD=
GOCELSYS_DB_HOST=localhost
GOCELSYS_DB_PORT=5432
# Fichiers hors du code
GOCELSYS_STATIC_ROOT=/srv/gocelsys/shared/static
GOCELSYS_MEDIA_ROOT=/srv/gocelsys/shared/media
# Durée des jetons
GOCELSYS_ACCESS_MINUTES=60
GOCELSYS_REFRESH_DAYS=14
