# =============================================================================
#  Réglages du déploiement Gocelsys (versionnés avec le code).
#  Modifiez sur votre PC, faites git push, puis relancez gocelsys-deploy sur le serveur.
# =============================================================================

# Domaine principal : c'est l'adresse officielle du site.
DOMAIN="gocelsys.com"

# Autres domaines : ils redirigent vers le domaine principal (avec et sans www).
ALIASES="gocelsys.fr gocelsys.online"

# IP du VPS : sert à vérifier que les DNS pointent bien ici avant de demander le certificat HTTPS.
SERVER_IP="72.60.212.142"

# E-mail de contact Let's Encrypt (avertissements d'expiration du certificat).
LE_EMAIL="admin@gocelsys.com"
